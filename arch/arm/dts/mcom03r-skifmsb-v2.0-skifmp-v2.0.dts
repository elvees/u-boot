/dts-v1/;

#include "mcom03r-skifmsb-v2.0.dtsi"

/ {
	model = "Skif-MSB v2.0, Skif-MP v2.0";
	compatible = "elvees,skifmsb-v2.0-skifmp-v2.0",
		     "elvees,skifmsb-skifmp",
		     "elvees,skifmp-v2.0",
		     "elvees,skifmp",
		     "elvees,skifmsb-v2.0",
		     "elvees,skifmsb",
		     "elvees,mcom03r";

	sdhci0_supply: regulator@0 {
		compatible = "regulator-fixed";
		regulator-name = "sdhci0-supply";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};
};

/* Pin for voltage supply for SDR subsystem. */
&gpio0b {
	sdr-hog {
		gpio-hog;
		gpios = <3 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

/* Pin for device power management.
 * 'high' - device is power on.
 * 'low' - device is power off.
 */
&gpio0b {
	power-ctl-hog {
		gpio-hog;
		gpios = <4 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

/* Pin for voltage supply of 5V
 * on USB-hub, HDMI and green led.
 */
&gpio0a {
	on5v-out-hog {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

&gpio0b {
	green-led-hog {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

&gpio0d {
	orange-led-hog {
		gpio-hog;
		gpios = <2 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

&gpio0d {
	usb-hub-reset-hog {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

/* Connected to eMMC */
&sdhci0 {
	status = "okay";

	non-removable;
	bus-width = <8>;

	vqmmc-supply = <&sdhci0_supply>;
};

/* Connected to MicroSD card */
&sdhci1 {
	status = "okay";

	/* TODO: Check higher frequencies */
	max-frequency = <12000000>;

	/* Disable High Speed support
	 * Disable 1.8V support
	 * Disable SDR50, SDR104 and DDR50 support
	 */
	sdhci-caps-mask = <0x7 0x4200000>;
	sdhci-caps = <0x0 0x0>;

	disable-wp;
};

&emac0 {
	status = "okay";

	phy-mode = "rgmii-id";
	phy-reset-gpios = <&gpio0d 6 GPIO_ACTIVE_LOW>;
	phy-handle = <&ethernet_phy0>;

	ethernet_phy0: ethernet-phy@1 {
		reg = <0x1>;
		motorcomm,clk-out-frequency-hz = <0>;
		rx-internal-delay-ps = <1800>;
		tx-internal-delay-ps = <1200>;
	};
};

/* Connected to USB 3.0 Type-A */
&usb0 {
	status = "okay";
};

/* Connected to USB 2.0 hub */
&usb1 {
	status = "okay";
};
